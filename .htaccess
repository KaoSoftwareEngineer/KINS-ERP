# ============================================================================
#  ปิดไม่ให้ Apache (XAMPP) เสิร์ฟโฟลเดอร์โปรเจกต์นี้ทั้งหมด
#
#  ทำไม: โปรเจกต์นี้วางอยู่ใน C:\xampp\htdocs ซึ่ง Apache เสิร์ฟออกเว็บพอร์ต 80
#  โดยอัตโนมัติ ทำให้ไฟล์ต่อไปนี้ถูกดาวน์โหลดจากเบราว์เซอร์ได้โดยไม่ต้องล็อกอิน:
#     /KINS/files/.env        <- รหัสผ่านฐานข้อมูล + รหัส SMTP + Google client id
#     /KINS/.git/             <- ประวัติโค้ดทั้งหมด
#     /KINS/files/server.js   <- ซอร์สโค้ดฝั่งเซิร์ฟเวอร์ทั้งไฟล์
#  และที่อันตรายที่สุดคือไฟล์ .php ในโฟลเดอร์อัปโหลดจะถูก Apache "รันจริง"
#  (ทดสอบยืนยันแล้ว) = ใครอัปโหลดไฟล์ .php เข้ามาได้ ก็สั่งรันโค้ดบนเครื่องได้
#
#  ระบบนี้ไม่ได้ใช้ Apache เลย — ฝั่ง API รันบน Node (พอร์ต 3000) และหน้าเว็บรันบน
#  Vite (พอร์ต 5173) จึงปิดการเข้าถึงผ่าน Apache ทั้งหมดได้อย่างปลอดภัย
#
#  ⚠️ ถ้าย้ายโปรเจกต์ออกจาก htdocs แล้ว ไฟล์นี้ไม่จำเป็นอีก (แต่เก็บไว้ก็ไม่เสียหาย)
# ============================================================================

# Apache 2.4 ขึ้นไป
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (เผื่อเครื่องที่ใช้เวอร์ชันเก่า)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# กันไว้อีกชั้น: ไม่ให้รันสคริปต์ใดๆ ในโฟลเดอร์นี้ ถึงแม้กฎด้านบนจะถูกปิดไป
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .phar
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .phar
Options -ExecCGI -Indexes
