# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของเครื่องคุณ
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kins_erp
PORT=3000

# ---- LINE Official Account (ตอบกลับลูกค้า/รับข้อความเข้า "รับออเดอร์เข้า") ----
# เอาค่าจาก LINE Developers Console > Messaging API channel ของคุณ
# ปล่อยว่างไว้ = ปิดฟีเจอร์ LINE (ระบบยังทำงานปกติ แค่ตอบกลับจะบันทึกเป็นบันทึกภายใน)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# แล้วตั้ง Webhook URL ใน LINE Developers = https://<โดเมนสาธารณะของคุณ>/api/line/webhook
