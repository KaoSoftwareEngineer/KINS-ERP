# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของเครื่องคุณ
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plum_erp
PORT=3000

# ---- go-live (ปล่อยว่าง = ค่า default สำหรับ dev) ----
# URL หน้าเว็บ (ใช้ตอน redirect จาก backend) — dev = http://localhost:5173
FRONTEND_URL=
# จำกัดโดเมนที่เรียก API ได้ (คั่นด้วย ,) — ปล่อยว่าง = อนุญาตเฉพาะ localhost 5173/3000 (dev)
# ตัวอย่าง prod: https://app.yourdomain.com,https://www.yourdomain.com  (http/https + www/ไม่ www = คนละ origin)
CORS_ORIGIN=
# ตั้งเป็น 1 หลังติดตั้ง SSL (https) เสร็จแล้วเท่านั้น — cookie จะส่งเฉพาะบน https
# ถ้าตั้งตอนยังเป็น http ธรรมดา cookie จะไม่ถูกตั้ง = ล็อกอินไม่ได้ทั้งระบบ
COOKIE_SECURE=
