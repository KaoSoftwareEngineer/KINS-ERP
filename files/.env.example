# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของเครื่องคุณ
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plum_erp
PORT=3000

# ---- go-live (ปล่อยว่าง = ค่า default สำหรับ dev) ----
# URL หน้าเว็บ (ใช้ตอน redirect จาก backend) — dev = http://localhost:5173
FRONTEND_URL=
# จำกัดโดเมนที่เรียก API ได้ (คั่นด้วย ,) — ปล่อยว่าง = เปิดทุกโดเมน (dev). ตัวอย่าง prod: https://app.yourdomain.com
CORS_ORIGIN=
